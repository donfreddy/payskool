{
  "name": "@payskool/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Shared Zod schemas, TypeScript types, utils and constants for PAYSKOOL",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./validators/*": "./src/validators/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./constants": "./src/constants.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@payskool/config-typescript": "workspace:*",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "zod": "^3.23.8"
  }
}

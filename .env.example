# =============================================================================
# PAYSKOOL — Environment Variables Template
# Copy to .env in each app directory and fill in real values
# =============================================================================

# ---- Database (PostgreSQL 16) ----
DATABASE_URL="postgresql://payskool:payskool_dev@localhost:5432/payskool_dev"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- API Server ----
API_PORT=3001
API_HOST="0.0.0.0"
NODE_ENV="development"

# ---- Auth / JWT ----
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_USE_256BIT_RANDOM"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ---- Encryption (for sensitive data at rest) ----
ENCRYPTION_KEY="CHANGE_ME_32_CHARS_MINIMUM_SECRET"

# ---- OTP / SMS ----
OTP_PROVIDER="console"     # console | twilio | orange
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""

# ---- Email ----
EMAIL_PROVIDER="console"   # console | resend | sendgrid
RESEND_API_KEY=""
EMAIL_FROM="noreply@payskool.com"

# ---- Payment Aggregators ----
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
WAVE_API_KEY=""

# ---- Storage ----
STORAGE_PROVIDER="local"   # local | s3
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Next.js Apps ----
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Misc ----
LOG_LEVEL="info"           # debug | info | warn | error
